# HTTPS для домену — автоматично (Let's Encrypt); WebSocket (/ws) Caddy прокидає сам.
{$DOMAIN} {
	encode zstd gzip

	# Заголовки безпеки. CSP: усе лише з нашого домену; wasm-unsafe-eval — декодер meshopt для моделей (WebAssembly),
	# blob:/data: — текстури, які GLTFLoader дістає з .glb; wss — WebSocket гри.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss://{$DOMAIN} blob: data:; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Файли з хешем у назві (Vite) не змінюються — хай браузер кешує надовго.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# З actuator назовні — лише health (для перевірки після деплою).
	@actuator {
		path /actuator/*
		not path /actuator/health
	}
	respond @actuator 404

	# Закритий API статей яєць — лише з самого сервера (генератор ходить на 127.0.0.1:8090, блок нижче), не через інтернет.
	respond /api/admin/* 404

	reverse_proxy app:8080 {
		# Під час деплою на мить живуть два контейнери app (DNS дає обидва), тож невдале з'єднання пробуємо ще.
		lb_try_duration 10s
		# Перезавантаження конфігу Caddy не рве WebSocket гравців одразу.
		stream_close_delay 10m
	}
}

# Генератор статей яєць (127.0.0.1:8090 на сервері, назовні не опубліковано) — сюди можна й /api/admin/*.
:8090 {
	reverse_proxy app:8080 {
		lb_try_duration 10s
	}
}
