# Скопіюй у .env на сервері (у DEPLOY_PATH) і заповни. .env у git не потрапляє.
DOMAIN=game.example.com
POSTGRES_PASSWORD=заміни-на-довгий-випадковий-пароль
# Токен закритого API статей яєць (генератор deploy/eggs): openssl rand -hex 32. Порожній — API вимкнений.
GAME_ADMIN_TOKEN=
# APP_IMAGE виставляє GitHub Actions при кожному деплої.
APP_IMAGE=ghcr.io/owner/repo:latest
